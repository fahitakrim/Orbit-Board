<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <include latin:keyboardLayout="@xml/key_styles_common" />
    <include latin:keyboardLayout="@xml/row_number_switch" />

    <!-- Row 1: 12 keys (8.333%p each) -->
    <Row
        latin:keyLabelFlags="fontNormal"
        latin:keyWidth="8.333%p">
        <switch>
            <case latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted">
                <!-- q: ধ -->
                <Key latin:keySpec="&#x09A7;" />
                <!-- w: ঊ -->
                <Key latin:keySpec="&#x098A;" />
                <!-- e: ঈ -->
                <Key latin:keySpec="&#x0988;" />
                <!-- r: ড় (hint র্, moreKeys ্র র্) -->
                <Key latin:keySpec="&#x09DC;" latin:keyHintLabel="&#x09B0;&#x09CD;" latin:moreKeys="&#x09CD;&#x09B0;,&#x09B0;&#x09CD;" />
                <!-- t: ঠ -->
                <Key latin:keySpec="&#x09A0;" />
                <!-- y: ঐ (hint ঞ) -->
                <Key latin:keySpec="&#x0990;" latin:keyHintLabel="&#x099E;" latin:moreKeys="&#x099E;" />
                <!-- u: উ (hint ৎ) -->
                <Key latin:keySpec="&#x0989;" latin:keyHintLabel="&#x09CE;" latin:moreKeys="&#x09CE;" />
                <!-- i: ই -->
                <Key latin:keySpec="&#x0987;" />
                <!-- o: ঔ -->
                <Key latin:keySpec="&#x0994;" />
                <!-- p: ফ -->
                <Key latin:keySpec="&#x09AB;" />
                <!-- [: ৈ -->
                <Key latin:keySpec="&#x09C8;" />
                <!-- ]: ৌ -->
                <Key latin:keySpec="&#x09CC;" />
            </case>
            <default>
                <!-- q: দ (hint ধ) -->
                <Key latin:keySpec="&#x09A6;" latin:keyHintLabel="&#x09A7;" latin:moreKeys="&#x09A7;" />
                <!-- w: ূ (hint ঊ) -->
                <Key latin:keySpec="&#x09C2;" latin:keyHintLabel="&#x098A;" latin:moreKeys="&#x098A;" />
                <!-- e: ী (hint ঈ) -->
                <Key latin:keySpec="&#x09C0;" latin:keyHintLabel="&#x0988;" latin:moreKeys="&#x0988;" />
                <!-- r: র (hint ড়, moreKeys: ড় center, ্র right, র্ left, র্য, ৰ, ৱ) -->
                <Key latin:keySpec="&#x09B0;" latin:keyHintLabel="&#x09DC;" latin:moreKeys="&#x09DC;,&#x09CD;&#x09B0;,&#x09B0;&#x09CD;,&#x09B0;&#x200D;&#x09CD;&#x09AF;,&#x09F0;,&#x09F1;" />
                <!-- t: ট (hint ঠ) -->
                <Key latin:keySpec="&#x099F;" latin:keyHintLabel="&#x09A0;" latin:moreKeys="&#x09A0;" />
                <!-- y: এ (hint ঐ, more ঐ ঞ) -->
                <Key latin:keySpec="&#x098F;" latin:keyHintLabel="&#x0990;" latin:moreKeys="&#x0990;,&#x099E;" />
                <!-- u: ু (hint উ, more উ ৎ) -->
                <Key latin:keySpec="&#x09C1;" latin:keyHintLabel="&#x0989;" latin:moreKeys="&#x0989;,&#x09CE;" />
                <!-- i: ি (hint ই) -->
                <Key latin:keySpec="&#x09BF;" latin:keyHintLabel="&#x0987;" latin:moreKeys="&#x0987;" />
                <!-- o: ও (hint ঔ) -->
                <Key latin:keySpec="&#x0993;" latin:keyHintLabel="&#x0994;" latin:moreKeys="&#x0994;" />
                <!-- p: প (hint ফ) -->
                <Key latin:keySpec="&#x09AA;" latin:keyHintLabel="&#x09AB;" latin:moreKeys="&#x09AB;" />
                <!-- [: ে (hint ৈ) -->
                <Key latin:keySpec="&#x09C7;" latin:keyHintLabel="&#x09C8;" latin:moreKeys="&#x09C8;" />
                <!-- ]: ো (hint ৌ) -->
                <Key latin:keySpec="&#x09CB;" latin:keyHintLabel="&#x09CC;" latin:moreKeys="&#x09CC;" />
            </default>
        </switch>
    </Row>

    <!-- Row 2: 9 keys (10%p each, indented 5%p) -->
    <Row
        latin:keyLabelFlags="fontNormal"
        latin:keyWidth="10%p">
        <switch>
            <case latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted">
                <!-- a: অ -->
                <Key latin:keySpec="&#x0985;" latin:keyXPos="5%p" />
                <!-- s: ষ -->
                <Key latin:keySpec="&#x09B7;" />
                <!-- d: ঢ -->
                <Key latin:keySpec="&#x09A2;" />
                <!-- f: থ -->
                <Key latin:keySpec="&#x09A5;" />
                <!-- g: ঘ -->
                <Key latin:keySpec="&#x0998;" />
                <!-- h: ঃ -->
                <Key latin:keySpec="&#x0983;" />
                <!-- j: ঝ -->
                <Key latin:keySpec="&#x099D;" />
                <!-- k: খ -->
                <Key latin:keySpec="&#x0996;" />
                <!-- l: ং -->
                <Key latin:keySpec="&#x0982;" />
            </case>
            <default>
                <!-- a: া (hint অ) -->
                <Key latin:keySpec="&#x09BE;" latin:keyXPos="5%p" latin:keyHintLabel="&#x0985;" latin:moreKeys="&#x0985;" />
                <!-- s: স (hint ষ) -->
                <Key latin:keySpec="&#x09B8;" latin:keyHintLabel="&#x09B7;" latin:moreKeys="&#x09B7;" />
                <!-- d: ড (hint ঢ) -->
                <Key latin:keySpec="&#x09A1;" latin:keyHintLabel="&#x09A2;" latin:moreKeys="&#x09A2;" />
                <!-- f: ত (hint থ, more থ ৎ) -->
                <Key latin:keySpec="&#x09A4;" latin:keyHintLabel="&#x09A5;" latin:moreKeys="&#x09A5;,&#x09CE;" />
                <!-- g: গ (hint ঘ) -->
                <Key latin:keySpec="&#x0997;" latin:keyHintLabel="&#x0998;" latin:moreKeys="&#x0998;" />
                <!-- h: হ (hint ঃ) -->
                <Key latin:keySpec="&#x09B9;" latin:keyHintLabel="&#x0983;" latin:moreKeys="&#x0983;" />
                <!-- j: জ (hint ঝ) -->
                <Key latin:keySpec="&#x099C;" latin:keyHintLabel="&#x099D;" latin:moreKeys="&#x099D;" />
                <!-- k: ক (hint খ) -->
                <Key latin:keySpec="&#x0995;" latin:keyHintLabel="&#x0996;" latin:moreKeys="&#x0996;" />
                <!-- l: ল (hint ং) -->
                <Key latin:keySpec="&#x09B2;" latin:keyHintLabel="&#x0982;" latin:moreKeys="&#x0982;" />
            </default>
        </switch>
    </Row>

    <!-- Row 3: Shift 11.5%p + 9 keys 8.55%p + Delete fillRight -->
    <Row
        latin:keyLabelFlags="fontNormal"
        latin:keyWidth="8.55%p">
        <Key
            latin:keyStyle="shiftKeyStyle"
            latin:keyWidth="11.5%p"
            latin:visualInsetsRight="1%p" />
        <switch>
            <case latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted">
                <!-- z: য (hint ্য) -->
                <Key latin:keySpec="&#x09AF;" latin:keyHintLabel="&#x09CD;&#x09AF;" latin:moreKeys="&#x09CD;&#x09AF;,&#x09B0;&#x200D;&#x09CD;&#x09AF;" />
                <!-- x: ঢ় -->
                <Key latin:keySpec="&#x09DD;" />
                <!-- c: ছ -->
                <Key latin:keySpec="&#x099B;" />
                <!-- v: ঋ -->
                <Key latin:keySpec="&#x098B;" />
                <!-- b: ভ -->
                <Key latin:keySpec="&#x09AD;" />
                <!-- n: ণ -->
                <Key latin:keySpec="&#x09A3;" />
                <!-- m: ঙ -->
                <Key latin:keySpec="&#x0999;" />
                <!-- ,: ৃ -->
                <Key latin:keySpec="&#x09C3;" />
                <!-- .: ঁ (Chandrabindu) -->
                <Key latin:keySpec="&#x0981;" />
            </case>
            <default>
                <!-- z: য় (hint ্য, popup options: ্য  য  র‍্য) -->
                <Key latin:keySpec="&#x09DF;" latin:keyHintLabel="&#x09CD;&#x09AF;" latin:moreKeys="&#x09CD;&#x09AF;,&#x09AF;,&#x09B0;&#x200D;&#x09CD;&#x09AF;" />
                <!-- x: শ (hint ঢ়) -->
                <Key latin:keySpec="&#x09B6;" latin:keyHintLabel="&#x09DD;" latin:moreKeys="&#x09DD;" />
                <!-- c: চ (hint ছ) -->
                <Key latin:keySpec="&#x099A;" latin:keyHintLabel="&#x099B;" latin:moreKeys="&#x099B;" />
                <!-- v: আ (hint ঋ) -->
                <Key latin:keySpec="&#x0986;" latin:keyHintLabel="&#x098B;" latin:moreKeys="&#x098B;" />
                <!-- b: ব (hint ভ) -->
                <Key latin:keySpec="&#x09AC;" latin:keyHintLabel="&#x09AD;" latin:moreKeys="&#x09AD;" />
                <!-- n: ন (hint ণ) -->
                <Key latin:keySpec="&#x09A8;" latin:keyHintLabel="&#x09A3;" latin:moreKeys="&#x09A3;" />
                <!-- m: ম (hint ঙ) -->
                <Key latin:keySpec="&#x09AE;" latin:keyHintLabel="&#x0999;" latin:moreKeys="&#x0999;" />
                <!-- ,: ৃ (Ri-kar) -->
                <Key latin:keySpec="&#x09C3;" />
                <!-- .: ্ (হসন্ত, hint ঁ, moreKeys ঁ ় zwnj zwj) -->
                <Key latin:keySpec="&#x09CD;" latin:keyHintLabel="&#x0981;" latin:moreKeys="&#x0981;,&#x09BC;,&#x200C;,&#x200D;" />
            </default>
        </switch>
        <Key
            latin:keyStyle="deleteKeyStyle"
            latin:keyWidth="fillRight"
            latin:visualInsetsLeft="1%p" />
    </Row>

    <!-- Row 4: Functional & Bottom Row -->
    <Row latin:keyWidth="10%p">
        <Key
            latin:keySpec="?&#x09E7;&#x09E8;&#x09E9;|!code/key_switch_alpha_symbol"
            latin:keyStyle="toSymbolKeyStyle"
            latin:keyWidth="14%p" />
        <switch>
            <case latin:bottomEmojiKeyEnabled="true">
                <Key
                    latin:keyStyle="emojiKeyStyle"
                    latin:keyWidth="10%p" />
                <include
                    latin:keyboardLayout="@xml/key_comma"
                    latin:keyWidth="9%p" />
                <Key
                    latin:keyStyle="spaceKeyStyle"
                    latin:keyWidth="43%p" />
            </case>
            <default>
                <include
                    latin:keyboardLayout="@xml/key_comma"
                    latin:keyWidth="12%p" />
                <Key
                    latin:keyStyle="spaceKeyStyle"
                    latin:keyWidth="50%p" />
            </default>
        </switch>
        <Key
            latin:keySpec="&#x0964;"
            latin:moreKeys=".,&#x0964;,?,!,&#x0965;"
            latin:keyLabelFlags="hasPopupHint"
            latin:keyWidth="10%p"
            latin:backgroundType="functional" />
        <Key
            latin:keyStyle="enterKeyStyle"
            latin:keyWidth="fillRight" />
    </Row>
</merge>
