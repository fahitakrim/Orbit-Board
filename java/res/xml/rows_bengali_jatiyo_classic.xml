<!-- Jatiyo Classic (Old) layout — Exactly matching Ridmik National (Classic) -->
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <include latin:keyboardLayout="@xml/key_styles_common" />
    <include latin:keyboardLayout="@xml/row_number_switch" />

    <!-- Row 1: 10 keys (10%p each) -->
    <Row
        latin:keyLabelFlags="fontNormal"
        latin:keyWidth="10%p">
        <switch>
            <case latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted">
                <!-- q: ং -->
                <Key latin:keySpec="&#x0982;" />
                <!-- w: ্য (য-ফলা) -->
                <Key latin:keySpec="&#x09CD;&#x09AF;" />
                <!-- e: ঢ -->
                <Key latin:keySpec="&#x09A2;" />
                <!-- r: ফ -->
                <Key latin:keySpec="&#x09AB;" />
                <!-- t: ঠ -->
                <Key latin:keySpec="&#x09A0;" />
                <!-- y: ছ -->
                <Key latin:keySpec="&#x099B;" />
                <!-- u: ঝ -->
                <Key latin:keySpec="&#x099D;" />
                <!-- i: ঞ -->
                <Key latin:keySpec="&#x099E;" />
                <!-- o: ঘ -->
                <Key latin:keySpec="&#x0998;" />
                <!-- p: ঢ় -->
                <Key latin:keySpec="&#x09DD;" />
            </case>
            <default>
                <!-- q: ঙ (hint ং, more ১,1) -->
                <Key latin:keySpec="&#x0999;" latin:keyHintLabel="&#x0982;" latin:moreKeys="&#x0982;,&#x09E7;,1" />
                <!-- w: য (hint য়, more য়,২,2) -->
                <Key latin:keySpec="&#x09AF;" latin:keyHintLabel="&#x09DF;" latin:moreKeys="&#x09DF;,&#x09E8;,2" />
                <!-- e: ড (hint ঢ, more ৩,3) -->
                <Key latin:keySpec="&#x09A1;" latin:keyHintLabel="&#x09A2;" latin:moreKeys="&#x09A2;,&#x09E9;,3" />
                <!-- r: প (hint ফ, more ৪,4) -->
                <Key latin:keySpec="&#x09AA;" latin:keyHintLabel="&#x09AB;" latin:moreKeys="&#x09AB;,&#x09EA;,4" />
                <!-- t: ট (hint ঠ, more ৫,5) -->
                <Key latin:keySpec="&#x099F;" latin:keyHintLabel="&#x09A0;" latin:moreKeys="&#x09A0;,&#x09EB;,5" />
                <!-- y: চ (hint ছ, more ৬,6) -->
                <Key latin:keySpec="&#x099A;" latin:keyHintLabel="&#x099B;" latin:moreKeys="&#x099B;,&#x09EC;,6" />
                <!-- u: জ (hint ঝ, more ৭,7) -->
                <Key latin:keySpec="&#x099C;" latin:keyHintLabel="&#x099D;" latin:moreKeys="&#x099D;,&#x09ED;,7" />
                <!-- i: হ (hint ঞ, more ৮,8) -->
                <Key latin:keySpec="&#x09B9;" latin:keyHintLabel="&#x099E;" latin:moreKeys="&#x099E;,&#x09EE;,8" />
                <!-- o: গ (hint ঘ, more ৯,9) -->
                <Key latin:keySpec="&#x0997;" latin:keyHintLabel="&#x0998;" latin:moreKeys="&#x0998;,&#x09EF;,9" />
                <!-- p: ড় (hint ঢ়, more ০,0) -->
                <Key latin:keySpec="&#x09DC;" latin:keyHintLabel="&#x09DD;" latin:moreKeys="&#x09DD;,&#x09E6;,0" />
            </default>
        </switch>
    </Row>

    <!-- Row 2: 9 keys (10%p each, indented 5%p) — Classic: f=ব, h=া -->
    <Row
        latin:keyLabelFlags="fontNormal"
        latin:keyWidth="10%p">
        <switch>
            <case latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted">
                <!-- a: ঋ -->
                <Key latin:keySpec="&#x098B;" latin:keyXPos="5%p" />
                <!-- s: ূ (hint ঊ) -->
                <Key latin:keySpec="&#x09C2;" latin:keyHintLabel="&#x098A;" latin:moreKeys="&#x098A;" />
                <!-- d: ী (hint ঈ) -->
                <Key latin:keySpec="&#x09C0;" latin:keyHintLabel="&#x0988;" latin:moreKeys="&#x0988;" />
                <!-- f: ভ -->
                <Key latin:keySpec="&#x09AD;" />
                <!-- g: র্ (রেফ) -->
                <Key latin:keySpec="&#x09B0;&#x09CD;" />
                <!-- h: অ -->
                <Key latin:keySpec="&#x0985;" />
                <!-- j: খ -->
                <Key latin:keySpec="&#x0996;" />
                <!-- k: থ -->
                <Key latin:keySpec="&#x09A5;" />
                <!-- l: ধ -->
                <Key latin:keySpec="&#x09A7;" />
            </case>
            <default>
                <!-- a: ৃ (hint ঐ, more ঐ) -->
                <Key latin:keySpec="&#x09C3;" latin:keyXPos="5%p" latin:keyHintLabel="&#x0990;" latin:moreKeys="&#x0990;" />
                <!-- s: ু (hint উ, more উ) -->
                <Key latin:keySpec="&#x09C1;" latin:keyHintLabel="&#x0989;" latin:moreKeys="&#x0989;" />
                <!-- d: ি (hint ই, more ই) -->
                <Key latin:keySpec="&#x09BF;" latin:keyHintLabel="&#x0987;" latin:moreKeys="&#x0987;" />
                <!-- f: ব (hint ভ, more ভ) -->
                <Key latin:keySpec="&#x09AC;" latin:keyHintLabel="&#x09AD;" latin:moreKeys="&#x09AD;" />
                <!-- g: ্ (হসন্ত, more ় নুকতা, zwnj, zwj) -->
                <Key latin:keySpec="&#x09CD;" latin:moreKeys="&#x09BC;,&#x200C;,&#x200D;" />
                <!-- h: া (hint আ, more আ) -->
                <Key latin:keySpec="&#x09BE;" latin:keyHintLabel="&#x0986;" latin:moreKeys="&#x0986;" />
                <!-- j: ক (hint খ, more খ) -->
                <Key latin:keySpec="&#x0995;" latin:keyHintLabel="&#x0996;" latin:moreKeys="&#x0996;" />
                <!-- k: ত (hint ৎ, more ৎ, থ) -->
                <Key latin:keySpec="&#x09A4;" latin:keyHintLabel="&#x09CE;" latin:moreKeys="&#x09CE;,&#x09A5;" />
                <!-- l: দ (hint ধ, more ধ) -->
                <Key latin:keySpec="&#x09A6;" latin:keyHintLabel="&#x09A7;" latin:moreKeys="&#x09A7;" />
            </default>
        </switch>
    </Row>

    <!-- Row 3: 7 keys (Shift 15%p + 7 keys 10%p + Delete fillRight) -->
    <Row
        latin:keyLabelFlags="fontNormal"
        latin:keyWidth="10%p">
        <Key
            latin:keyStyle="shiftKeyStyle"
            latin:keyWidth="15%p"
            latin:visualInsetsRight="1%p" />
        <switch>
            <case latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted">
                <!-- z: ঃ (বিসর্গ) -->
                <Key latin:keySpec="&#x0983;" />
                <!-- x: ৌ (ঔ-কার, hint ঔ) -->
                <Key latin:keySpec="&#x09CC;" latin:keyHintLabel="&#x0994;" latin:moreKeys="&#x0994;" />
                <!-- c: ৈ (ঐ-কার, hint ঐ) -->
                <Key latin:keySpec="&#x09C8;" latin:keyHintLabel="&#x0990;" latin:moreKeys="&#x0990;" />
                <!-- v: ্র (র-ফলা) -->
                <Key latin:keySpec="&#x09CD;&#x09B0;" />
                <!-- b: ণ -->
                <Key latin:keySpec="&#x09A3;" />
                <!-- n: ষ -->
                <Key latin:keySpec="&#x09B7;" />
                <!-- m: শ -->
                <Key latin:keySpec="&#x09B6;" />
            </case>
            <default>
                <!-- z: ঁ (চন্দ্রবিন্দু, hint ঃ বিসর্গ) -->
                <Key latin:keySpec="&#x0981;" latin:keyHintLabel="&#x0983;" latin:moreKeys="&#x0983;" />
                <!-- x: ো (ও-কার, hint ও) -->
                <Key latin:keySpec="&#x09CB;" latin:keyHintLabel="&#x0993;" latin:moreKeys="&#x0993;" />
                <!-- c: ে (এ-কার, hint এ) -->
                <Key latin:keySpec="&#x09C7;" latin:keyHintLabel="&#x098F;" latin:moreKeys="&#x098F;" />
                <!-- v: র (hint ল, more ল, ৱ, ৰ, র্য) -->
                <Key latin:keySpec="&#x09B0;" latin:keyHintLabel="&#x09B2;" latin:moreKeys="&#x09B2;,&#x09F1;,&#x09F0;,&#x09B0;&#x200D;&#x09CD;&#x09AF;" />
                <!-- b: ন (hint ণ) -->
                <Key latin:keySpec="&#x09A8;" latin:keyHintLabel="&#x09A3;" latin:moreKeys="&#x09A3;" />
                <!-- n: স (hint ষ) -->
                <Key latin:keySpec="&#x09B8;" latin:keyHintLabel="&#x09B7;" latin:moreKeys="&#x09B7;" />
                <!-- m: ম (hint শ) -->
                <Key latin:keySpec="&#x09AE;" latin:keyHintLabel="&#x09B6;" latin:moreKeys="&#x09B6;" />
            </default>
        </switch>
        <Key
            latin:keyStyle="deleteKeyStyle"
            latin:keyWidth="fillRight"
            latin:visualInsetsLeft="1%p" />
    </Row>

    <!-- Row 4: Functional & Bottom Row -->
    <Row latin:keyWidth="10%p">
        <Key
            latin:keySpec="?&#x09E7;&#x09E8;&#x09E9;|!code/key_switch_alpha_symbol"
            latin:keyStyle="toSymbolKeyStyle"
            latin:keyWidth="14%p" />
        <switch>
            <case latin:bottomEmojiKeyEnabled="true">
                <Key
                    latin:keyStyle="emojiKeyStyle"
                    latin:keyWidth="10%p" />
                <Key
                    latin:keySpec=","
                    latin:moreKeys="&apos;,&quot;,;,:"
                    latin:keyLabelFlags="hasPopupHint"
                    latin:keyWidth="9%p"
                    latin:backgroundType="functional" />
                <Key
                    latin:keyStyle="spaceKeyStyle"
                    latin:keyWidth="42%p" />
            </case>
            <default>
                <Key
                    latin:keySpec=","
                    latin:moreKeys="&apos;,&quot;,;,:"
                    latin:keyLabelFlags="hasPopupHint"
                    latin:keyWidth="12%p"
                    latin:backgroundType="functional" />
                <Key
                    latin:keyStyle="spaceKeyStyle"
                    latin:keyWidth="49%p" />
            </default>
        </switch>
        <switch>
            <case latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted">
                <Key
                    latin:keySpec="."
                    latin:moreKeys=".,&#x0964;,?,!,&#x0965;"
                    latin:keyLabelFlags="hasPopupHint"
                    latin:keyWidth="10%p"
                    latin:backgroundType="functional" />
            </case>
            <default>
                <Key
                    latin:keySpec="&#x0964;"
                    latin:moreKeys=".,&#x0964;,?,!,&#x0965;"
                    latin:keyLabelFlags="hasPopupHint"
                    latin:keyWidth="10%p"
                    latin:backgroundType="functional" />
            </default>
        </switch>
        <Key
            latin:keyStyle="enterKeyStyle"
            latin:keyWidth="fillRight" />
    </Row>
</merge>
