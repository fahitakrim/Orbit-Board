<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <include latin:keyboardLayout="@xml/key_styles_common" />
    <include latin:keyboardLayout="@xml/key_styles_currency" />
    <Row
        latin:keyLabelFlags="fontNormal"
        latin:keyWidth="10%p">
        <Key latin:keySpec="~" />
        <Key latin:keySpec="`" />
        <Key latin:keySpec="|" />
        <Key latin:keySpec="&#x20B9;" latin:moreKeys="&#x09F3;" />
        <Key latin:keySpec="&#x221A;" />
        <Key latin:keySpec="&#x03C0;" latin:moreKeys="&#x03A0;" />
        <Key latin:keySpec="&#x00F7;" />
        <Key latin:keySpec="&#x00D7;" />
        <Key latin:keySpec="{" />
        <Key latin:keySpec="}" />
    </Row>
    <Row
        latin:keyLabelFlags="fontNormal"
        latin:keyWidth="10%p">
        <Key latin:keySpec="&#x21E5;" />
        <Key latin:keySpec="&#x00A3;" />
        <Key latin:keySpec="$" />
        <Key latin:keySpec="%" latin:moreKeys="&#x2030;" />
        <Key latin:keySpec="^" latin:moreKeys="&#x2192;" />
        <Key latin:keySpec="&#x00B0;" latin:moreKeys="&#x2022;" />
        <Key latin:keySpec="_" />
        <Key latin:keySpec="=" latin:moreKeys="&#x2260;" />
        <Key latin:keySpec="[" />
        <Key latin:keySpec="]" />
    </Row>
    <Row
        latin:keyLabelFlags="fontNormal"
        latin:keyWidth="10%p">
        <Key
            latin:keyStyle="backFromMoreSymbolBengaliKeyStyle"
            latin:keyWidth="15%p"
            latin:visualInsetsRight="1%p" />
        <Key latin:keySpec="&#x25C8;" latin:moreKeys="&#x09B0;&#x09CD;&#x200D;&#x09AF;" />
        <Key latin:keySpec="&#x00AE;" />
        <Key latin:keySpec="&#x00A9;" />
        <Key latin:keySpec="&#x2122;" />
        <Key latin:keySpec="\\\\" />
        <Key latin:keySpec="&lt;" />
        <Key latin:keySpec="&gt;" />
        <Key
            latin:keyStyle="deleteKeyStyle"
            latin:keyWidth="fillRight"
            latin:visualInsetsLeft="1%p" />
    </Row>
    <Row
        latin:keyWidth="10%p"
        latin:backgroundType="functional">
        <Key
            latin:keyStyle="toAlphaBengaliKeyStyle"
            latin:keyWidth="14%p" />
        <include
            latin:keyboardLayout="@xml/key_comma"
            latin:keyWidth="10%p" />
        <Key
            latin:keyStyle="spaceKeyStyle"
            latin:keyWidth="43%p" />
        <include
            latin:keyboardLayout="@xml/key_period"
            latin:keyWidth="10%p" />
        <Key
            latin:keyStyle="enterKeyStyle"
            latin:keyWidth="fillRight" />
    </Row>
</merge>
