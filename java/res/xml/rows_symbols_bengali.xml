<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <include latin:keyboardLayout="@xml/key_styles_common" />
    <include latin:keyboardLayout="@xml/key_styles_currency" />
    <Row
        latin:keyLabelFlags="fontNormal"
        latin:keyWidth="10%p">
        <Key latin:keySpec="&#x09E7;" latin:moreKeys="1,!noPanelAutoMoreKey!" />
        <Key latin:keySpec="&#x09E8;" latin:moreKeys="2,!noPanelAutoMoreKey!" />
        <Key latin:keySpec="&#x09E9;" latin:moreKeys="3,!noPanelAutoMoreKey!" />
        <Key latin:keySpec="&#x09EA;" latin:moreKeys="4,!noPanelAutoMoreKey!" />
        <Key latin:keySpec="&#x09EB;" latin:moreKeys="5,!noPanelAutoMoreKey!" />
        <Key latin:keySpec="&#x09EC;" latin:moreKeys="6,!noPanelAutoMoreKey!" />
        <Key latin:keySpec="&#x09ED;" latin:moreKeys="7,!noPanelAutoMoreKey!" />
        <Key latin:keySpec="&#x09EE;" latin:moreKeys="8,!noPanelAutoMoreKey!" />
        <Key latin:keySpec="&#x09EF;" latin:moreKeys="9,!noPanelAutoMoreKey!" />
        <Key latin:keySpec="&#x09E6;" latin:moreKeys="0,!noPanelAutoMoreKey!" />
    </Row>
    <Row
        latin:keyLabelFlags="fontNormal"
        latin:keyWidth="10%p">
        <Key latin:keySpec="\@" />
        <Key latin:keySpec="\#" />
        <Key latin:keySpec="&#x09F3;" latin:moreKeys="$,&#x20AC;,&#xA3;,&#xA5;,&#x20B9;" />
        <Key latin:keySpec="%" />
        <Key latin:keySpec="&amp;" />
        <Key latin:keySpec="*" latin:moreKeys="&#x2605;" />
        <Key latin:keySpec="-" latin:moreKeys="&#x2014;" />
        <Key latin:keySpec="+" />
        <Key latin:keySpec="(" latin:moreKeys="&lt;" />
        <Key latin:keySpec=")" latin:moreKeys="&gt;" />
    </Row>
    <Row
        latin:keyLabelFlags="fontNormal"
        latin:keyWidth="10%p">
        <Key
            latin:keyStyle="toMoreSymbolKeyStyle"
            latin:keyWidth="15%p"
            latin:visualInsetsRight="1%p" />
        <Key latin:keySpec="!" />
        <Key latin:keySpec="&quot;" />
        <Key latin:keySpec="'" />
        <Key latin:keySpec=":" latin:moreKeys="&#x205D;" />
        <Key latin:keySpec=";" />
        <Key latin:keySpec="/" />
        <Key latin:keySpec="?" />
        <Key
            latin:keyStyle="deleteKeyStyle"
            latin:keyWidth="fillRight"
            latin:visualInsetsLeft="1%p" />
    </Row>
    <Row
        latin:keyWidth="10%p"
        latin:backgroundType="functional">
        <Key
            latin:keyStyle="toAlphaBengaliKeyStyle"
            latin:keyWidth="14%p" />
        <include
            latin:keyboardLayout="@xml/key_comma"
            latin:keyWidth="10%p" />
        <Key
            latin:keyStyle="spaceKeyStyle"
            latin:keyWidth="43%p" />
        <include
            latin:keyboardLayout="@xml/key_period"
            latin:keyWidth="10%p" />
        <Key
            latin:keyStyle="enterKeyStyle"
            latin:keyWidth="fillRight" />
    </Row>
</merge>
